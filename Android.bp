soong_namespace {
}

cc_prebuilt_library_shared {
	name: "libril",
	owner: "huawei",
	strip: {
		none: true,
	},
	target: {
		android_arm: {
			srcs: ["vendor/lib/libril.so"],
		},
		android_arm64: {
			srcs: ["vendor/lib64/libril.so"],
		},
	},
	compile_multilib: "both",
	check_elf_files: false,
	prefer: true,
	soc_specific: true,
}
