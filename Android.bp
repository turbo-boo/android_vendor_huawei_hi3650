soong_namespace {
}

android_app_import {
	name: "gnss_supl20service_hisi",
	owner: "huawei",
	apk: "system/priv-app/gnss_supl20service_hisi/gnss_supl20service_hisi.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}

android_app_import {
	name: "opencamera",
	owner: "huawei",
	apk: "system/app/opencamera/opencamera.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	product_specific: true,
	overrides: [
		"Aperture",
		"Camera2"
	],
}
